# Postgres connection. Local Docker (npm run db:up):
DATABASE_URL=postgres://r1:r1@localhost:5432/r1
# Tests use their own database (created by docker-compose):
TEST_DATABASE_URL=postgres://r1:r1@localhost:5432/r1_test

# Signs login sessions. Use the SAME value as the old Express app so existing
# sessions stay valid across the switch. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Seeds the first admin on an empty users table; changing it later resets that
# admin's password (applied once per value).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Web Push (optional). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Testing aids (optional)
# ANONYMIZE_PHONES=true      # Excel import replaces phone numbers with a dummy
# DUMMY_PHONE=01010101010
